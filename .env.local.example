# Postgres connection string (local Postgres, Docker, or a Render database).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/empowered_ink"

# Cloudinary (cover image uploads)
CLOUDINARY_CLOUD_NAME="..."
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# Admin (/admin). Sessions are signed with ADMIN_SESSION_SECRET if set,
# otherwise with ADMIN_PASSWORD.
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET=""

# Email the owner when an author submits a book (same SMTP settings as the
# member directory). Leave unset to skip the email; submissions still work.
NOTIFY_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# The magazine page that embeds the directory (used for "Back to the Directory").
NEXT_PUBLIC_DIRECTORY_PAGE_URL="https://possiblewomanmagazine.com/empowered-ink"
