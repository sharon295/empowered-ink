generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookStatus {
  pending
  approved
  rejected
}

// Which spotlight section a book is placed in for its placementMonth.
// null = no spotlight; the book only ever appears in the A–Z list.
enum Placement {
  featured
  new_on_shelf
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Book {
  id                   String     @id @default(cuid())
  title                String
  author               String
  email                String
  phone                String
  description          String?
  coverImageUrl        String?
  purchaseLink         String
  primaryCategory      String
  secondaryCategories  String     @default("[]")
  otherCategoryLabel   String?
  isFeatured           Boolean    @default(false)
  featuredUntil        DateTime?
  status               BookStatus @default(pending)
  submittedAt          DateTime   @default(now())
  updatedAt            DateTime   @default(now()) @updatedAt
  approvedAt           DateTime?

  stripeSessionId      String?
  categoryAddonPaid    Boolean    @default(false)

  // The section a book shows in is computed at read time from these two
  // fields and the current America/Denver month (lib/sections.ts): before
  // placementMonth the book is hidden, during it the book is in its section,
  // and afterwards it is in the A–Z list. Nothing moves books on a schedule.
  placement            Placement?
  placementMonth       String?    // "YYYY-MM", America/Denver

  // Which shareable form link an author used ("featured", "new_on_shelf" or
  // "list"). Only a suggestion for the owner's approve controls; it never
  // places a book by itself.
  requestedPlacement   String?

  // Derived fields, recomputed on every create/edit (lib/derive.ts).
  sortTitle            String     @default("")
  searchText           String     @default("")
  categories           String[]   @default([])

  @@index([status])
  @@index([isFeatured, featuredUntil])
  @@index([status, sortTitle, id])
  @@index([placement, placementMonth])
}
