# Local dev: SQLite file. On Render, switch prisma/schema.prisma datasource
# provider to "postgresql" and set this to the Render Postgres connection string.
DATABASE_URL="file:./dev.db"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Cloudinary (cover image uploads)
CLOUDINARY_CLOUD_NAME="..."
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# Admin review page
ADMIN_PASSWORD="change-me"

# Used to build absolute URLs for Stripe success/cancel redirects
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
